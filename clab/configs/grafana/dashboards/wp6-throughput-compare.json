{
    "uid": "ndt-wp6-throughput-compare",
    "title": "NDT WP6 - Throughput (Last N Experiments)",
    "timezone": "",
    "schemaVersion": 39,
    "version": 1,
    "editable": true,
    "time": {
        "from": "now-30m",
        "to": "now"
    },
    "templating": {
        "list": [
            {
                "name": "last_n",
                "type": "custom",
                "label": "Last N experiments",
                "query": "5,10,20,50",
                "current": {
                    "text": "10",
                    "value": "10"
                }
            }
        ]
    },
    "panels": [
        {
            "id": 1,
            "type": "timeseries",
            "title": "Throughput (Mbps) - auto compare last N experiments",
            "datasource": {
                "type": "postgres",
                "uid": "udr_postgres"
            },
            "gridPos": {
                "h": 12,
                "w": 24,
                "x": 0,
                "y": 0
            },
            "targets": [
                {
                    "refId": "A",
                    "format": "time_series",
                    "rawQuery": true,
                    "rawSql": "SELECT ts AS \"time\", value AS \"value\", experiment_id AS \"metric\"\nFROM metrics\nWHERE $__timeFilter(ts)\n  AND metric_name = 'throughput_mbps'\n  AND experiment_id IN (\n    SELECT DISTINCT experiment_id\n    FROM metrics\n    WHERE metric_name = 'throughput_mbps'\n    ORDER BY experiment_id DESC\n    LIMIT ${last_n}\n  )\nORDER BY 1;",
                    "timeColumn": "time",
                    "metricColumn": "metric"
                }
            ],
            "fieldConfig": {
                "defaults": {},
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "single"
                }
            }
        },
        {
            "id": 2,
            "type": "table",
            "title": "Last N experiments (latest throughput)",
            "datasource": {
                "type": "postgres",
                "uid": "udr_postgres"
            },
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 12
            },
            "targets": [
                {
                    "refId": "B",
                    "format": "table",
                    "rawQuery": true,
                    "rawSql": "SELECT experiment_id,\n       MAX(ts) AS last_ts,\n       (ARRAY_AGG(value ORDER BY ts DESC))[1] AS last_throughput_mbps\nFROM metrics\nWHERE metric_name = 'throughput_mbps'\nGROUP BY experiment_id\nORDER BY experiment_id DESC\nLIMIT ${last_n};"
                }
            ],
            "options": {
                "showHeader": true
            }
        }
    ],
    "annotations": {
        "list": []
    }
}