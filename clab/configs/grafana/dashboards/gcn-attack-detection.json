{
  "uid": "gcn-attack-detection",
  "title": "NDT WP8 - GCN Attack Detection Dashboard",
  "description": "Real-time WiFi 7 MLO attack detection using Graph Convolutional Networks. Shows predictions, confidence scores, attack timeline, and model performance metrics.",
  "tags": [
    "ndt",
    "wp8",
    "gcn",
    "ml",
    "attack-detection",
    "security"
  ],
  "timezone": "UTC",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ],
    "time_options": [
      "5m",
      "15m",
      "1h",
      "6h",
      "12h",
      "24h",
      "2d",
      "7d"
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Attack Detections",
        "datasource": {
          "type": "postgres",
          "uid": "udr_postgres"
        },
        "enable": true,
        "iconColor": "rgba(255, 96, 96, 1)",
        "rawQuery": true,
        "rawSql": "SELECT ts_start as time, CONCAT('Attack: ', segment_id, ' (conf: ', ROUND(confidence::numeric, 2), ')') as text, 'attack' as tags FROM gcn_predictions WHERE $__timeFilter(ts_start) AND prediction = 1 AND experiment_id ~ '${experiment_filter:regex}' ORDER BY ts_start"
      },
      {
        "name": "Model Version Changes",
        "datasource": {
          "type": "postgres",
          "uid": "udr_postgres"
        },
        "enable": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "rawQuery": true,
        "rawSql": "WITH version_changes AS ( SELECT model_version, MIN(created_at) as time FROM gcn_predictions WHERE $__timeFilter(ts_start) GROUP BY model_version ) SELECT time, CONCAT('Model: ', model_version) as text, 'model' as tags FROM version_changes ORDER BY time"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "experiment_filter",
        "type": "query",
        "label": "Experiment Filter",
        "datasource": {
          "type": "postgres",
          "uid": "udr_postgres"
        },
        "query": "SELECT DISTINCT experiment_id FROM gcn_predictions ORDER BY experiment_id DESC",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": [
            "$__all"
          ],
          "selected": true
        },
        "options": []
      },
      {
        "name": "model_version",
        "type": "query",
        "label": "Model Version",
        "datasource": {
          "type": "postgres",
          "uid": "udr_postgres"
        },
        "query": "SELECT DISTINCT model_version FROM gcn_predictions ORDER BY model_version DESC",
        "refresh": 1,
        "includeAll": true,
        "multi": false,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total Predictions",
      "description": "Total number of predictions made by GCN model",
      "datasource": {
        "type": "postgres",
        "uid": "udr_postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) as value FROM gcn_predictions WHERE $__timeFilter(ts_start) AND experiment_id ~ '${experiment_filter:regex}' AND model_version ~ '${model_version:regex}'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              },
              {
                "value": 10,
                "color": "green"
              },
              {
                "value": 100,
                "color": "yellow"
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "orientation": "auto",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Attacks Detected",
      "description": "Number of segments classified as attacks (prediction=1)",
      "datasource": {
        "type": "postgres",
        "uid": "udr_postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) as value FROM gcn_predictions WHERE $__timeFilter(ts_start) AND prediction = 1 AND experiment_id ~ '${experiment_filter:regex}' AND model_version ~ '${model_version:regex}'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "yellow"
              },
              {
                "value": 10,
                "color": "red"
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "orientation": "auto",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Attack Rate",
      "description": "Percentage of segments classified as attacks",
      "datasource": {
        "type": "postgres",
        "uid": "udr_postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND(100.0 * SUM(CASE WHEN prediction = 1 THEN 1 ELSE 0 END) / COUNT(*), 1) as value FROM gcn_predictions WHERE $__timeFilter(ts_start) AND experiment_id ~ '${experiment_filter:regex}' AND model_version ~ '${model_version:regex}'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 20,
                "color": "yellow"
              },
              {
                "value": 50,
                "color": "orange"
              },
              {
                "value": 80,
                "color": "red"
              }
            ]
          },
          "decimals": 1
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "orientation": "auto",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Avg Confidence",
      "description": "Average confidence score across all predictions",
      "datasource": {
        "type": "postgres",
        "uid": "udr_postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND(AVG(confidence)::numeric, 3) as value FROM gcn_predictions WHERE $__timeFilter(ts_start) AND experiment_id ~ '${experiment_filter:regex}' AND model_version ~ '${model_version:regex}'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 0.6,
                "color": "yellow"
              },
              {
                "value": 0.8,
                "color": "green"
              }
            ]
          },
          "decimals": 3,
          "min": 0,
          "max": 1
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "orientation": "auto",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Avg Inference Time",
      "description": "Average time taken per prediction",
      "datasource": {
        "type": "postgres",
        "uid": "udr_postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND(AVG(inference_time_ms)::numeric, 1) as value FROM gcn_predictions WHERE $__timeFilter(ts_start) AND experiment_id ~ '${experiment_filter:regex}' AND model_version ~ '${model_version:regex}' AND inference_time_ms IS NOT NULL"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 100,
                "color": "yellow"
              },
              {
                "value": 500,
                "color": "red"
              }
            ]
          },
          "decimals": 1
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "orientation": "auto",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Active Model",
      "description": "Currently active GCN model version",
      "datasource": {
        "type": "postgres",
        "uid": "udr_postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT model_version as value FROM gcn_predictions WHERE $__timeFilter(ts_start) ORDER BY ts_start DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "orientation": "auto",
        "textMode": "value"
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Attack Detection Timeline",
      "description": "Real-time attack detection over time. Red = Attack, Green = Normal",
      "datasource": {
        "type": "postgres",
        "uid": "udr_postgres"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts_start AS \"time\", prediction::float as value, CONCAT(experiment_id, ' / ', entity_id) as metric FROM gcn_predictions WHERE $__timeFilter(ts_start) AND experiment_id ~ '${experiment_filter:regex}' AND model_version ~ '${model_version:regex}' ORDER BY ts_start"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80,
            "spanNulls": false,
            "drawStyle": "bars",
            "barAlignment": 0,
            "pointSize": 5
          },
          "min": 0,
          "max": 1,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "sum",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Prediction Confidence Over Time",
      "description": "Confidence scores for each prediction. Higher is more certain.",
      "datasource": {
        "type": "postgres",
        "uid": "udr_postgres"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts_start AS \"time\", confidence as value, CONCAT(experiment_id, ' / ', entity_id, ' (pred=', prediction, ')') as metric FROM gcn_predictions WHERE $__timeFilter(ts_start) AND experiment_id ~ '${experiment_filter:regex}' AND model_version ~ '${model_version:regex}' ORDER BY ts_start"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false,
            "pointSize": 3,
            "showPoints": "always"
          },
          "min": 0,
          "max": 1
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "type": "histogram",
      "title": "Confidence Score Distribution",
      "description": "Distribution of confidence scores across all predictions",
      "datasource": {
        "type": "postgres",
        "uid": "udr_postgres"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT confidence FROM gcn_predictions WHERE $__timeFilter(ts_start) AND experiment_id ~ '${experiment_filter:regex}' AND model_version ~ '${model_version:regex}'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "bucketSize": 0.05
      }
    },
    {
      "id": 20,
      "type": "piechart",
      "title": "Prediction Distribution",
      "description": "Overall distribution of Normal vs Attack predictions",
      "datasource": {
        "type": "postgres",
        "uid": "udr_postgres"
      },
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN prediction = 0 THEN 'Normal' ELSE 'Attack' END as metric, COUNT(*) as value FROM gcn_predictions WHERE $__timeFilter(ts_start) AND experiment_id ~ '${experiment_filter:regex}' AND model_version ~ '${model_version:regex}' GROUP BY prediction"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Normal"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Attack"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value",
            "percent"
          ]
        },
        "pieType": "donut",
        "displayLabels": [
          "name",
          "percent"
        ]
      }
    },
    {
      "id": 21,
      "type": "bargauge",
      "title": "Attack Rate by Experiment",
      "description": "Attack detection rate per experiment",
      "datasource": {
        "type": "postgres",
        "uid": "udr_postgres"
      },
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT experiment_id as metric, ROUND(100.0 * SUM(CASE WHEN prediction = 1 THEN 1 ELSE 0 END) / COUNT(*), 1) as value FROM gcn_predictions WHERE $__timeFilter(ts_start) AND experiment_id ~ '${experiment_filter:regex}' AND model_version ~ '${model_version:regex}' GROUP BY experiment_id ORDER BY value DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 20,
                "color": "yellow"
              },
              {
                "value": 50,
                "color": "orange"
              },
              {
                "value": 80,
                "color": "red"
              }
            ]
          },
          "min": 0,
          "max": 100
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Model Performance Summary",
      "description": "Key performance indicators for the GCN model",
      "datasource": {
        "type": "postgres",
        "uid": "udr_postgres"
      },
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'Total Segments' as metric, COUNT(*)::text as value FROM gcn_predictions WHERE $__timeFilter(ts_start) AND experiment_id ~ '${experiment_filter:regex}' AND model_version ~ '${model_version:regex}'"
        },
        {
          "refId": "B",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'Avg Confidence' as metric, CONCAT(ROUND(AVG(confidence)::numeric * 100, 1), '%') as value FROM gcn_predictions WHERE $__timeFilter(ts_start) AND experiment_id ~ '${experiment_filter:regex}' AND model_version ~ '${model_version:regex}'"
        },
        {
          "refId": "C",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'Avg Inference Time' as metric, CONCAT(ROUND(AVG(inference_time_ms)::numeric, 1), ' ms') as value FROM gcn_predictions WHERE $__timeFilter(ts_start) AND experiment_id ~ '${experiment_filter:regex}' AND model_version ~ '${model_version:regex}' AND inference_time_ms IS NOT NULL"
        },
        {
          "refId": "D",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'Unique Experiments' as metric, COUNT(DISTINCT experiment_id)::text as value FROM gcn_predictions WHERE $__timeFilter(ts_start) AND experiment_id ~ '${experiment_filter:regex}' AND model_version ~ '${model_version:regex}'"
        },
        {
          "refId": "E",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'Active Model' as metric, model_version as value FROM gcn_predictions WHERE $__timeFilter(ts_start) ORDER BY created_at DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "orientation": "vertical",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 30,
      "type": "table",
      "title": "Recent Predictions",
      "description": "Latest predictions from the GCN model",
      "datasource": {
        "type": "postgres",
        "uid": "udr_postgres"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT experiment_id as \"Experiment\", entity_id as \"Entity\", segment_id as \"Segment\", ts_start as \"Start Time\", CASE WHEN prediction = 0 THEN 'Normal' ELSE 'Attack' END as \"Prediction\", ROUND(confidence::numeric, 3) as \"Confidence\", CONCAT('[', ROUND((probabilities->>0)::numeric, 3), ', ', ROUND((probabilities->>1)::numeric, 3), ']') as \"Probabilities [Normal, Attack]\", ROUND(inference_time_ms::numeric, 1) as \"Inference (ms)\", model_version as \"Model\", created_at as \"Detected At\" FROM gcn_predictions WHERE $__timeFilter(ts_start) AND experiment_id ~ '${experiment_filter:regex}' AND model_version ~ '${model_version:regex}' ORDER BY created_at DESC LIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Prediction"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Attack": {
                        "text": "Attack",
                        "color": "red"
                      },
                      "Normal": {
                        "text": "Normal",
                        "color": "green"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.displayMode",
                "value": "color-background"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Confidence"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 3
              },
              {
                "id": "custom.displayMode",
                "value": "gradient-gauge"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "red"
                    },
                    {
                      "value": 0.7,
                      "color": "yellow"
                    },
                    {
                      "value": 0.9,
                      "color": "green"
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": []
      }
    },
    {
      "id": 40,
      "type": "timeseries",
      "title": "Inference Performance Over Time",
