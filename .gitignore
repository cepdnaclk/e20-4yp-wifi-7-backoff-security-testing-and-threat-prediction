.playwright-cli/

# Playwright test output (reports, traces, screenshots, videos)
test-results/
tests/node_modules/
tests/reports/
tests/test-results/

# Model training intermediates (keep best_model.pt, not checkpoints/logs)
twin/registry/gcn/*/checkpoints/
twin/registry/gcn/*/logs/

# GNN training data (large — generated locally, not committed)
twin/gnn/training_data/

# Session screenshots (root-level PNGs)
/*.png

# Local backups
backups/
